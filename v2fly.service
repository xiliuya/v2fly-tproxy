#!/system/bin/sh

MOD_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$MOD_DIR/common_function.sh" ]; then
	. "$MOD_DIR/common_function.sh"
fi

load_conf_var CONF_DIR "/data/adb/v2fly/"
load_conf_var PID_FILE "${CONF_DIR}/v2ray.pid"
load_conf_var LOG_FILE "${CONF_DIR}/v2ray.log"
load_conf_var LISTENER_PID "${CONF_DIR}/listener.pid"
load_conf_var LISTENER_LOG "${CONF_DIR}/listener.log"
load_conf_var LOG_TZ "${CONF_DIR}/zoneinfo/Asia/Shanghai"
load_conf_var CONF_FILE "${CONF_DIR}/client.json"
load_conf_var V2FLY_BIN "${CONF_DIR}/bin/v2ray"
load_conf_var JSON_VER "v4"

if [ ! -f "${CONF_DIR}/v2ray.conf" ]; then
	cp "$MOD_DIR/v2fly_template.conf" "${CONF_DIR}/v2ray.conf"
fi

get_pid_state() {
	local pid_file="$1"

	[ -f "$pid_file" ] || return 1
	local pid
	pid="$(cat "$pid_file" 2>/dev/null)"

	[ -n "$pid" ] || return 1
	[ -d "/proc/$pid" ] || return 1
	grep -q "State:[[:space:]]*Z" "/proc/$pid/status" 2>/dev/null && return 1
	return 0

}
is_running() {
	get_pid_state "$PID_FILE"
}

clean_cgroups() {
	local pid=$1
	local pid_file=$2

	# 强制将进程的 cgroup 移入系统根节点 (逃离 App cgroup 连坐)
	echo $pid >/sys/fs/cgroup/cgroup.procs 2>/dev/null || true
	echo $pid >/dev/cpuset/tasks 2>/dev/null || true
	echo $pid >/dev/stune/tasks 2>/dev/null || true
	echo $pid >"$pid_file"

}
start() {
	if is_running; then
		echo "v2ray is already running (PID: $(cat "$PID_FILE"))"
		return 1
	fi

	case "$JSON_VER" in
	v4)
		format_arg="auto"
		;;
	v5)
		format_arg="jsonv5"
		;;
	*)
		echo "Unknown version"
		;;
	esac

	echo "Starting v2ray..."

	# 确保日志目录存在
	mkdir -p "$(dirname "$LOG_FILE")"

	# 确保运行时能正常使用CA
	export SSL_CERT_DIR=/system/etc/security/cacerts
	export TZ=$LOG_TZ

	# 使用 setsid 后台运行并将输出重定向，记录 PID
	setsid "$V2FLY_BIN" run -format "$format_arg" -config "$CONF_FILE" >"$LOG_FILE" 2>&1 &

	clean_cgroups $! $PID_FILE

	if ! get_pid_state "$LISTENER_PID"; then
		# 监听wifi/移动网络 route 状态
		# 状态改变时会导致 table id 改变
		# 需要修改 ip rule 让 mark 指向新 table
		setsid $MOD_DIR/route_change_listener.sh >"$LISTENER_LOG" 2>&1 &
		clean_cgroups $! $LISTENER_PID
		echo "listener started successfully (PID: $(cat "$LISTENER_PID"))"
	fi

	if is_running; then
		echo "v2ray started successfully (PID: $(cat "$PID_FILE"))"
	else
		echo "Error: v2ray failed to start. Check $LOG_FILE for details."
		rm -f "$PID_FILE"
		return 1
	fi
}

# 通用服务停止函数
# 用法: stop_service <pid_file_path> [service_name]
stop_service() {
	pid_file="$1"
	name="${2:-service}"

	if [ -z "$pid_file" ]; then
		echo "Error: stop_service requires a PID file path."
		return 1
	fi

	# 1. PID 文件不存在，或者 PID 对应的进程未运行
	if [ ! -f "$pid_file" ]; then
		echo "$name is not running."
		return 0
	fi

	pid=$(cat "$pid_file" 2>/dev/null)

	# 简单校验 PID 是否为合法数字
	case "$pid" in
	'' | *[!0-9]*)
		echo "Invalid PID in $pid_file, removing stale file..."
		rm -f "$pid_file"
		return 0
		;;
	esac

	# 检查 PID 对应进程是否存在 (kill -0)
	if ! kill -0 "$pid" 2>/dev/null; then
		echo "$name is not running (stale PID file)."
		rm -f "$pid_file"
		return 0
	fi

	# 2. 发送 SIGTERM 尝试优雅停止
	echo "Stopping $name (PID: $pid)..."
	kill "$pid" 2>/dev/null

	# 3. 等待进程退出 (等待最多 5 秒)
	cnt=0
	while kill -0 "$pid" 2>/dev/null; do
		sleep 1
		cnt=$((cnt + 1))
		if [ "$cnt" -ge 5 ]; then
			echo "Process $pid did not terminate gracefully, forcing kill..."
			kill -9 "$pid" 2>/dev/null
			break
		fi
	done

	# 4. 清理 PID 文件
	rm -f "$pid_file"
	echo "$name stopped."
	return 0
}

stop() {
	stop_service "$PID_FILE" V2Ray
	stop_service "$LISTENER_PID" route_change_listener.sh
}

restart() {
	stop
	sleep 1
	start
}

# 通用服务状态检测函数
# 用法: status_service <pid_file_path> [service_name]
# 返回码: 0 -> 正在运行
#         1 -> 已停止 (PID 文件残留/无效)
#         3 -> 未运行 (PID 文件不存在)
status_service() {
	pid_file="$1"
	name="${2:-service}"

	if [ -z "$pid_file" ]; then
		echo "Error: status_service requires a PID file path."
		return 1
	fi

	# 1. PID 文件不存在，确定为未运行
	if [ ! -f "$pid_file" ]; then
		echo "$name is stopped."
		return 3
	fi

	pid=$(cat "$pid_file" 2>/dev/null)

	# 2. 校验 PID 内容是否为纯数字
	case "$pid" in
	'' | *[!0-9]*)
		echo "$name is stopped (invalid PID file: '$pid')."
		return 1
		;;
	esac

	# 3. 检查 PID 对应进程是否存在 (kill -0 检测)
	if kill -0 "$pid" 2>/dev/null; then
		echo "$name is running (PID: $pid)."
		return 0
	else
		echo "$name is stopped (dead but PID file exists: $pid)."
		return 1
	fi
}

status() {
	status_service "$PID_FILE" V2Ray
	status_service "$LISTENER_PID" route_change_listener.sh
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart)
	restart
	;;
status)
	status
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	exit 1
	;;
esac
