#!/system/bin/sh

MOD_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$MOD_DIR/common_function.sh" ]; then
	. "$MOD_DIR/common_function.sh"
fi

load_conf_var CONF_DIR "/data/adb/v2fly/"
load_conf_var PID_FILE "${CONF_DIR}/v2ray.pid"
load_conf_var LISTENER_PID "${CONF_DIR}/listener.pid"
load_conf_var LOG_FILE "${CONF_DIR}/v2ray.log"
load_conf_var LOG_TZ "${CONF_DIR}/zoneinfo/Asia/Shanghai"
load_conf_var CONF_FILE "${CONF_DIR}/client.json"
load_conf_var V2FLY_BIN "${CONF_DIR}/bin/v2ray"
load_conf_var JSON_VER "v4"

if [ ! -f "${CONF_DIR}/v2ray.conf" ]; then
	cp "$MOD_DIR/v2fly_template.conf" "${CONF_DIR}/v2ray.conf"
fi

get_pid_state() {
	local pid_file="$1"

	[ -f "$pid_file" ] || return 1
	local pid
	pid="$(cat "$pid_file" 2>/dev/null)"

	[ -n "$pid" ] || return 1
	[ -d "/proc/$pid" ] || return 1
	grep -q "State:[[:space:]]*Z" "/proc/$pid/status" 2>/dev/null && return 1
	return 0

}
is_running() {
	get_pid_state "$PID_FILE"
}

clean_cgroups() {
	local pid=$1
	local pid_file=$2

	# 强制将进程的 cgroup 移入系统根节点 (逃离 App cgroup 连坐)
	echo $pid >/sys/fs/cgroup/cgroup.procs 2>/dev/null || true
	echo $pid >/dev/cpuset/tasks 2>/dev/null || true
	echo $pid >/dev/stune/tasks 2>/dev/null || true
	echo $pid >"$pid_file"

}
start() {
	if is_running; then
		echo "v2ray is already running (PID: $(cat "$PID_FILE"))"
		return 1
	fi

	case "$JSON_VER" in
	v4)
		format_arg="auto"
		;;
	v5)
		format_arg="jsonv5"
		;;
	*)
		echo "Unknown version"
		;;
	esac

	echo "Starting v2ray..."

	# 确保日志目录存在
	mkdir -p "$(dirname "$LOG_FILE")"

	# 确保运行时能正常使用CA
	export SSL_CERT_DIR=/system/etc/security/cacerts
	export TZ=$LOG_TZ

	# 使用 setsid 后台运行并将输出重定向，记录 PID
	setsid "$V2FLY_BIN" run -format "$format_arg" -config "$CONF_FILE" >"$LOG_FILE" 2>&1 &

	clean_cgroups $! $PID_FILE

	if ! get_pid_state "$LISTENER_PID"; then
		# 监听wifi/移动网络 route 状态
		# 状态改变时会导致 table id 改变
		# 需要修改 ip rule 让 mark 指向新 table
		setsid $MOD_DIR/route_change_listener.sh >/dev/null 2>&1 &
		clean_cgroups $! $LISTENER_PID
		echo "listener started successfully (PID: $(cat "$LISTENER_PID"))"
	fi

	if is_running; then
		echo "v2ray started successfully (PID: $(cat "$PID_FILE"))"
	else
		echo "Error: v2ray failed to start. Check $LOG_FILE for details."
		rm -f "$PID_FILE"
		return 1
	fi
}

stop() {
	if ! is_running; then
		echo "v2ray is not running."
		rm -f "$PID_FILE"
		return 0
	fi

	PID="$(cat "$PID_FILE")"
	echo "Stopping v2ray (PID: $PID)..."
	kill "$PID"

	# 等待进程退出
	CNT=0
	while is_running; do
		sleep 0.5
		CNT=$((CNT + 1))
		if [ "$CNT" -gt 10 ]; then
			echo "Process did not terminate gracefully, forcing kill..."
			kill -9 "$PID" 2>/dev/null
			break
		fi
	done

	rm -f "$PID_FILE"
	echo "v2ray stopped."
}

restart() {
	stop
	sleep 1
	start
}

status() {
	if is_running; then
		echo "v2ray is running (PID: $(cat "$PID_FILE"))"
	else
		echo "v2ray is stopped."
		return 1
	fi
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart)
	restart
	;;
status)
	status
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	exit 1
	;;
esac
